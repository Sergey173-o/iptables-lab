# Проброс host-only TCP/8080 на центральный Nginx.
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -s 192.168.56.0/24 -d 192.168.0.2/32 -p tcp --dport 80 -m conntrack --ctstate DNAT -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -s 192.168.56.0/24 -d 192.168.56.10/32 -p tcp --dport 8080 -j DNAT --to-destination 192.168.0.2:80
-A POSTROUTING -s 192.168.56.0/24 -d 192.168.0.2/32 -p tcp --dport 80 -m conntrack --ctstate DNAT -j MASQUERADE
COMMIT
